FROM python:3.12-slim

WORKDIR /app
COPY api/ ./api/
COPY src/ ./src/
COPY configs/ ./configs/
COPY setup.py .

COPY alembic_migrations/ ./alembic_migrations/
COPY alembic.ini .

COPY pyproject.toml uv.lock ./

RUN uv sync --extra api --frozen

EXPOSE 8000

CMD ["uv", "run", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]