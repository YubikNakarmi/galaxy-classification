FROM python:3.12-slim

WORKDIR /mlflow

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip && \
    pip install --no-cache-dir \
    mlflow[azure]==3.13.0 \
    azure-storage-blob \
    azure-identity \
    pymysql \

EXPOSE 5000

CMD ["sh", "-c", "mlflow db upgrade ${BACKEND_STORE_URI} && mlflow server --backend-store-uri ${BACKEND_STORE_URI} --default-artifact-root ${ARTIFACT_ROOT} --host 0.0.0.0 --port 5000"]
