# Core paths
ENV_PATH=.env
ML_YAML_PATH=configs/ml.yaml
CORE_YAML_PATH=configs/core.yaml
BACKEND_CONFIG_PATH=configs/backend.yaml
PYTHONPATH=
ROOT_DIR=

# Azure Storage and DVC
AZURE_STORAGE_CONNECTION_STRING=""
# Optional Azurite/local value:
# AZURE_STORAGE_CONNECTION_STRING_LOCAL="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;..."
DVC_AZURE_CONTAINER_NAME=dvc-storage

# Database
DATABASE_URL=sqlite:///app.db
# Legacy; prefer MLFLOW_BACKEND_STORE_URI for MLflow
MYSQLURL_REMOTE=

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MLFLOW_HTTP_REQUEST_MAX_RETRIES=0
MLFLOW_HTTP_REQUEST_TIMEOUT=10
MLFLOW_BACKEND_STORE_URI=
MLFLOW_ARTIFACT_ROOT=

# API to BentoML routes
BENTOML_DEFAULT_URL=http://bentoml:3000/default
BENTOML_HUBBLE_URL=http://bentoml:3000/hubble
BENTOML_DIRICHLET_URL=http://bentoml:3000/dirichlet

# Logging and CLI
LOG_JSON=False
NO_LIVE=0

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=